# Browser-visible settings for local testing only. Never commit a real key.
VITE_API_BASE_URL=/api
VITE_API_KEY=
# Vite's proxy runs on the PC; the phone uses the frontend HTTPS origin.
API_PROXY_TARGET=http://127.0.0.1:8000
# For deployment use an actual HTTPS backend URL or reverse-proxy /api.
# Direct cross-origin requests need backend CORS, including Retry-After exposure.
