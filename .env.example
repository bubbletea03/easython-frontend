# Recommended: same-origin proxy. No API key is included in the browser build.
VITE_API_BASE_URL=/api
BACKEND_API_URL=http://127.0.0.1:8000
BACKEND_API_KEY=
# On Vercel use the actual public HTTPS backend in BACKEND_API_URL.
# BACKEND_* variables stay on the Vite/Vercel server.
# Optional direct browser connection for local testing only:
# VITE_API_BASE_URL=https://actual-backend.example
# VITE_API_KEY=browser-visible-test-key
